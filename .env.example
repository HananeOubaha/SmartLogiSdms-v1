# ============================================================================
# .ENV.EXAMPLE - Exemple de configuration d'environnement
# ============================================================================
# Copier ce fichier en .env et remplir les valeurs
# ATTENTION : Ne JAMAIS commiter le fichier .env réel !
# ============================================================================

# ========== SPRING FRAMEWORK ==========
SPRING_PROFILES_ACTIVE=docker
SPRING_APPLICATION_NAME=smartlogi-sdms
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_SMARTLOGI=DEBUG

# ========== DATABASE - PostgreSQL ==========
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/smartlogi1_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ========== JPA / HIBERNATE ==========
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQL15Dialect
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# ========== LIQUIBASE ==========
SPRING_LIQUIBASE_ENABLED=true
SPRING_LIQUIBASE_CHANGE_LOG=classpath:db/changelog/db.changelog-master.yaml

# ========== JWT SECURITY ==========
# ⚠️  CHANGER CES VALEURS EN PRODUCTION !
JWT_SECRET=duainIbvm6qS9wZvHcHgswRdH0QiBhbpirG37iS1AHcv00rPWBkss7jz0zQ8EGq0tWcCgBoaVcn+jnoh4UIRew==
JWT_EXPIRATION_MS=86400000

# ========== ACTUATOR / HEALTH ==========
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,metrics,info,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# ========== TIMEZONE ==========
TZ=Europe/Paris

# ========== JAVA OPTIONS ==========
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ========== JENKINS CI/CD ==========
JENKINS_URL=http://localhost:8081
JENKINS_USER=admin
JENKINS_TOKEN=<your-jenkins-token>

# ========== SONARQUBE ANALYSIS ==========
SONAR_HOST_URL=http://127.0.0.1:9000
SONAR_LOGIN=<your-sonarqube-token>
SONAR_PROJECT_KEY=SmartLogiSdms
SONAR_PROJECT_NAME=SmartLogiSdms

# ========== DOCKER REGISTRY ==========
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=<your-docker-username>
DOCKER_PASSWORD=<your-docker-token>
DOCKER_IMAGE_NAME=smartlogi/sdms
DOCKER_IMAGE_TAG=0.3.0

# ========== GITHUB ==========
GITHUB_TOKEN=<your-github-token>
GITHUB_REPO=HananeOubaha/SmartLogiSdms-v1

# ========== NOTIFICATIONS ==========
SLACK_WEBHOOK_URL=<your-slack-webhook-url>
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=<your-email@gmail.com>
EMAIL_PASSWORD=<your-email-password>

# ========== OPTIONNEL: OAuth2 ==========
OAUTH2_GOOGLE_CLIENT_ID=<your-google-client-id>
OAUTH2_GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ========== OPTIONNEL: Cloud AWS ==========
AWS_REGION=eu-west-1
AWS_S3_BUCKET=smartlogi-sdms
AWS_ACCOUNT_ID=<your-aws-account-id>
AWS_ACCESS_KEY_ID=<your-aws-access-key>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-key>

